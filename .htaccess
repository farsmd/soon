# محافظت از فایل دیتابیس و کانفیگ در آپاچی — این فایل‌ها نباید مستقیم از وب در دسترس باشند
<FilesMatch "\.(sqlite|sqlite3|db)$">
    Require all denied
    Order Allow,Deny
    Deny from all
</FilesMatch>

<Files "config.php">
    Require all denied
    Order Allow,Deny
    Deny from all
</Files>


# --- صفحه ۴۰۴ هوشمند (۹٫۹۹٫۳۳) — آدرس‌های مرده مثل price.html قدیمی ---
ErrorDocument 404 /404.php


# --- آدرس‌های تمیز سئودوست (نسخه ۹٫۱۳) ---
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ریدایرکت آدرس‌های قدیمی /cms/* به صفحه اصلی (۹٫۹۹٫۳۴)
    RewriteRule ^cms(/.*)?$ / [R=301,L]

    # ۳۰۱ از آدرس‌های قدیمی به تمیز (فقط GET/HEAD تا POST فرم‌ها داده از دست ندهد؛ THE_REQUEST تا لوپ نشود)
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/products\.php[\s?] [NC]
    RewriteRule ^products\.php$ /products [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/page\.php\?slug=([A-Za-z0-9_-]+) [NC]
    RewriteRule ^page\.php$ /%1 [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/order\.php[\s?] [NC]
    RewriteRule ^order\.php$ /order [R=301,L,QSA]

    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} \s/card\.php[\s?] [NC]
    RewriteRule ^card\.php$ /card [R=301,L,QSA]
    RewriteCond %{THE_REQUEST} \s/track\.php[\s?]
    RewriteRule ^track\.php$ /track [R=301,L,QSA]

    # بازنویسی داخلی آدرس تمیز به فایل واقعی (POST حفظ می‌شود؛ فایل‌ها و پوشه‌های واقعی دست‌نخورده)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^products/?$ products.php [L,QSA]
    RewriteRule ^order/?$ order.php [L,QSA]
    RewriteRule ^card/?$ card.php [L,QSA]
    RewriteRule ^track/?$ track.php [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^blog/([A-Za-z0-9_-]+)/?$ blog.php?slug=$1 [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
    RewriteRule ^([A-Za-z0-9_-]+)/?$ page.php?slug=$1 [L,QSA]
</IfModule>

# --- بهینه‌سازی سرعت (نسخه ۹٫۱۲٫۴) ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|webp|gif|woff2|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
